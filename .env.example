# GraphIDS project overrides (copy to .env and customize)
# Secrets (GH_TOKEN, R2 creds, AWS creds) go in ~/.env.local — see dotfiles repo

# SLURM settings
export GRAPHIDS_SLURM_ACCOUNT="PAS1266"
export GRAPHIDS_SLURM_PARTITION="gpu"
export GRAPHIDS_GPU_TYPE="v100"

# Scratch filesystem (90-day purge)
export GRAPHIDS_SCRATCH="/fs/scratch/PAS1266"

# Python command (use "python" — OSC module system provides it)
export GRAPHIDS_PYTHON="python"

# Persistent shared data lake (raw CSVs, versioned caches, MLflow)
export GRAPHIDS_LAKE_ROOT="/fs/ess/PAS1266/graphids"

# Model checkpoints, metrics, traces, and per-user runs
export GRAPHIDS_RUN_ROOT="/fs/ess/PAS1266/graphids/dev/${USER}"
export GRAPHIDS_SLURM_LOG_DIR="${GRAPHIDS_LAKE_ROOT}/slurm_logs"

# Diagnostic runners take explicit output paths. For CUDA graph comparisons:
# export GRAPH_ROOT="${GRAPHIDS_RUN_ROOT}/experimentruns/cuda_graph_YYYY_MM_DD"
