  "clock_policy": {
    "method": "For replay logs: prefix maximum within each verified log interface, then stable chronological merge; within-interface frame order preserved. Other inputs: global prefix maximum.",
    "maximum_correction_seconds": 0.001,
    "output": "Derived CSV plus original/derived row indices, replay interface and old/new timestamp for every moved/corrected row; raw lake untouched.",
    "failure": "Reject row/interface correspondence mismatch or within-interface correction over 1 ms; never silently sort, drop or truncate frames.",
    "rationale": "Full replay clock audit: global backsteps up to 7.895 ms arise from interleaved interfaces, while within-interface backsteps are at most 69 microseconds. Avoid shifting valid frames by several milliseconds."
  },
  "heldout_in_weight_training": [
    "random_id_fuzzing"
  ],
  "limitations": [
    "One dataset family and one seed; no independent incident-level attack intervals",
    "Background-derived variants are grouped within query splits, not counted as independent acquisitions",
    "Malformed fuzzing-3 excluded; multi-GB random-ID target caches remain outside this first multi-attack source fit",
    "Existing target normal/DoS results are previously inspected diagnostic evidence; no fresh holdout claim",
    "Sampled background fingerprints establish known reuse, not absence of all shared traffic; no trip/day independence is claimed."
  ],
